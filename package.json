{
  "name": "attest-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean && rm -rf packages/*/dist",
    "typecheck": "tsc -b tsconfig.build.json --noEmit false --dry 2>/dev/null || tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:claims": "node scripts/check-forbidden-words.mjs",
    "lint:rule-docs": "node scripts/check-rule-docs.mjs",
    "check": "pnpm lint:claims && pnpm build && pnpm test && pnpm lint:rule-docs",
    "attest": "node packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
