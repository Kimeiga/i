# Copy to .env and fill in. Never commit the real file.
# The private signing key is the only secret here whose loss is unrecoverable:
# exports signed with a lost key cannot be re-signed, and a leaked key lets
# somebody else sign an evidence export that verifies against our published
# public key. Store it in the platform's secret manager, not in a file.

DATABASE_URL=postgres://localhost:5432/attest

# GitHub OAuth app: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/auth/github/callback

# Generated by `pnpm --filter @attestci/api keygen`.
# Publish EVIDENCE_PUBLIC_KEY; keep every retired public key published too, so
# old exports stay verifiable after a rotation.
EVIDENCE_KEY_ID=
EVIDENCE_PUBLIC_KEY=
EVIDENCE_PRIVATE_KEY=

# Merchant of record (Paddle). Webhooks are rejected outright without the secret.
MOR_WEBHOOK_SECRET=
MOR_PRODUCT_SOLO=
MOR_PRODUCT_TEAM=

PUBLIC_URL=http://localhost:8080
DASHBOARD_URL=http://localhost:3000/dashboard
PRICING_URL=http://localhost:3000/pricing
PORT=8080
