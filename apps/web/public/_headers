# Cloudflare reads this from the deployed assets. It replaces the headers()
# block in next.config.ts, which a static export ignores.
#
# The CSP is deliberately tight: this site loads no third-party script, no
# third-party font, no analytics and no embeds, so there is nothing legitimate
# for a permissive policy to allow. connect-src stays 'self' because the only
# request the page can make is to the first-party event sink.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
