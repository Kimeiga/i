{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "minimumVersion": "3.23.0",
  "entry": [
    "scripts/**/*.mjs",
    "packages/action/src/run.mjs"
  ],
  "ignoreFindings": [
    "gtm/landing-archive/**",
    "fixtures/**"
  ],
  "duplicates": {
    "ignore": [
      "gtm/landing-archive/**",
      "fixtures/**"
    ]
  },
  "health": {
    "ignore": [
      "gtm/landing-archive/**",
      "fixtures/**"
    ]
  },
  "audit": {
    "gate": "new-only"
  }
}
